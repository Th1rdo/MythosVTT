{
  "name": "mesa",
  "version": "0.1.0",
  "description": "Mesa — a lean, self-hosted virtual tabletop for our Ordem Paranormal games",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"node --watch-path=server --watch-path=shared server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/main.ts",
    "world": "node server/cli/world.ts",
    "import": "node server/cli/import-foundry.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test shared/*.test.ts server/*.test.ts"
  },
  "dependencies": {
    "@fontsource/signika": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "classic-level": "^3.0.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "pixi.js": "^8.22.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
